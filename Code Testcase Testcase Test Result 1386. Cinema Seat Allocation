class Solution {
    public int maxNumberOfFamilies(int n, int[][] reservedSeats) {

        // Store reserved seats for each row using a bitmask
        java.util.HashMap<Integer, Integer> rows = new java.util.HashMap<>();

        for (int[] seat : reservedSeats) {
            int row = seat[0];
            int col = seat[1];

            // Set the bit corresponding to the seat
            rows.put(row, rows.getOrDefault(row, 0) | (1 << (col - 1)));
        }

        // Rows without any reserved seat can fit 2 families
        int answer = (n - rows.size()) * 2;

        // Seats 2,3,4,5
        int leftMask =
                (1 << 1) | (1 << 2) | (1 << 3) | (1 << 4);

        // Seats 4,5,6,7
        int middleMask =
                (1 << 3) | (1 << 4) | (1 << 5) | (1 << 6);

        // Seats 6,7,8,9
        int rightMask =
                (1 << 5) | (1 << 6) | (1 << 7) | (1 << 8);

        // Check rows having reserved seats
        for (int mask : rows.values()) {

            boolean left = (mask & leftMask) == 0;
            boolean middle = (mask & middleMask) == 0;
            boolean right = (mask & rightMask) == 0;

            if (left && right) {
                // Two families can sit
                answer += 2;
            } 
            else if (left || middle || right) {
                // Only one family can sit
                answer += 1;
            }
        }

        return answer;
    }
}
